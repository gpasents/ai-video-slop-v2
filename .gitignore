# ==============================================================================
# VIDEO SLOP V2 - GITIGNORE
# ==============================================================================

# 🛑 SECURITY: NEVER UPLOAD API KEYS
.env

# 🎬 PIPELINE ASSETS (HEAVY & TEMPORARY)
# We ignore these so we don't upload gigabytes of stock footage to GitHub
# Note: By targeting the contents (*/*), we can whitelist specific files inside
assets*/*
!assets_urban_mysteries/bg_music.mp3

output*/
uploaded/

# 🧠 STATE / MEMORY
# Keeps your local generated history separate from the public repo
history.json
eleven.txt
sens.txt

# 🐍 PYTHON JUNK & VIRTUAL ENVIRONMENTS
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# 💻 IDE / VS CODE SETTINGS
.vscode/